<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SkimStats.ViewModels"
        xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="SkimStats.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="SkimStats">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>

    <!-- how every graph looks: title text above a chart -->
    <Window.DataTemplates>
        <DataTemplate DataType="vm:GraphViewModel">
            <DockPanel Margin="8">
                <TextBlock DockPanel.Dock="Top" Text="{Binding Text}" FontSize="18" />
                <lvc:CartesianChart Series="{Binding Series}"
                                    XAxes="{Binding XAxes}" YAxes="{Binding YAxes}"
                                    LegendPosition="{Binding LegendPosition}"
                                    TooltipPosition="Hidden"
                                    AnimationsSpeed="0:0:0" EasingFunction="{x:Null}" />
            </DockPanel>
        </DataTemplate>
    </Window.DataTemplates>

    <Panel Margin="8">
        <!-- 2x2 graphs with drive space along the bottom -->
        <Grid RowDefinitions="*,*,Auto" ColumnDefinitions="*,*">
            <ContentControl Grid.Row="0" Grid.Column="0" Content="{Binding Cpu}" />
            <ContentControl Grid.Row="0" Grid.Column="1" Content="{Binding Ram}" />
            <ContentControl Grid.Row="1" Grid.Column="0" Content="{Binding Disk}" />
            <ContentControl Grid.Row="1" Grid.Column="1" Content="{Binding Network}" />
            <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Margin="8" FontSize="16"
                       Text="{Binding DrivesText}" TextWrapping="Wrap" />
        </Grid>

        <!-- only shows when stats failed to start -->
        <TextBlock Text="{Binding Error}" FontSize="20" TextWrapping="Wrap"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
    </Panel>

</Window>
